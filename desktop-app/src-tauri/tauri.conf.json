{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Secret Manager",
  "version": "0.1.0",
  "identifier": "com.secret-manager.desktop",
  "build": {
    "beforeDevCommand": "echo 'No frontend build step — using static HTML'",
    "devUrl": "../dist",
    "beforeBuildCommand": "echo 'No build step'",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Secret Manager",
        "width": 900,
        "height": 700,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "dir": "../dist"
      }
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "msi", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
